{
  "controls": {
    "home.clipboard.paste.picture": {
      "command": "edit.pastePicture",
      "params": null,
      "note": "U:grid/main: Paste > Picture puts what was copied on the sheet as a floating picture: the picture made by Copy as Picture, else a picture of the copied cells (drawn by the worksheet's own painter through the host's renderRange). Not in gridcraft, which copies cell data and HTML (not checked against upstream)."
    },
    "home.clipboard.paste.linked-picture": {
      "command": "edit.pasteLinkedPicture",
      "params": null,
      "note": "U:grid/main: Paste > Linked Picture puts a picture of the copied cells on the sheet that the sheet draws live from them, so it follows the cells as they change. Not in gridcraft (not checked against upstream). Limit: a file keeps only a still picture, so a linked picture saved to .xlsx and reopened is a plain picture."
    },
    "home.clipboard.copy.copy-as-picture": {
      "command": "edit.copyPicture",
      "params": null,
      "note": "U:grid/main: Copy as Picture draws the cells as shown on screen to a PNG (fonts, fills, borders, number formats, merges, conditional formats, pictures) that Paste > Picture puts on the sheet; the clipboard also carries the cells' text and the picture as <img> for other applications. Excel's Copy Picture box (As shown when printed, Bitmap) is not built: the picture is always as shown on screen. Not in gridcraft (not checked against upstream)."
    },
    "home.clipboard.formatPainter": {
      "params": null,
      "note": "A click runs edit.formatPainter {} (on, or off when on); a double-click runs {sticky: true} (gridcraft ribbon/home.rs:94)."
    }
  },
  "commands": {
    "edit.pastePicture": {"args": [], "sourceRef": "office:Excel Paste > Picture", "summary": "Paste the copied cells as a picture object."},
    "edit.pasteLinkedPicture": {"args": [], "sourceRef": "office:Excel Paste > Linked Picture", "summary": "Paste the copied cells as a picture that follows them."},
    "edit.copyPicture": {"args": [], "sourceRef": "office:Excel Copy > Copy as Picture", "summary": "Copy the selection as a picture."}
  },
