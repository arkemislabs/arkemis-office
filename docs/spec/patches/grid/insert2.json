    "insert.charts.pieDoughnut.3-d-pie": {
      "command": "insert.chart",
      "args": {
        "kind": "pie3d"
      },
      "note": "U:grid/insert: not in gridcraft (no 3-D charts); drawn after Excel (core/grid/lib/chart-render-extra.mjs): the pie from above and in front, a wall under the front half. Not checked against upstream."
    },
    "insert.charts.pieDoughnut.pie-of-pie": {
      "command": "insert.chart",
      "args": {
        "kind": "pieOfPie"
      },
      "note": "U:grid/insert: not in gridcraft; the last three values join into an Other slice that a second pie breaks down, as Excel splits by position. Not checked against upstream."
    },
    "insert.charts.pieDoughnut.bar-of-pie": {
      "command": "insert.chart",
      "args": {
        "kind": "barOfPie"
      },
      "note": "U:grid/insert: not in gridcraft; as Pie of Pie with a stacked bar for the second plot. Not checked against upstream."
    },
    "insert.charts.scatterBubble.scatter": {
