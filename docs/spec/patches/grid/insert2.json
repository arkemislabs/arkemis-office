      "command": "insert.chart",
      "args": {
        "kind": "scatterSmooth"
      },
      "note": "U:grid/insert: gridcraft has Scatter and Scatter with Lines only; this is its scatter-with-lines chart with every series smoothed (the chart renderer interpolates a spline)."
    },
    "insert.charts.scatterBubble.scatter-with-straight-lines-and-markers": {
      "command": "insert.chart",
      "args": {
        "kind": "scatterStraight"
