{
  "controls": {
    "chartDesign.layouts.addElement": {
      "note": "U:grid/chart-design: checked against gridcraft (the Add Chart Element menu: legend positions, data labels and gridlines through chart.set; Chart Title and Axis Titles through chart.addElement)."
    },
    "chartDesign.layouts.quickLayout": {
      "args": {
        "layout": "<n>"
      },
      "note": "U:grid/chart-design: checked against gridcraft (chart.quickLayout 1 to 6: legend, data labels, gridlines and axis titles); the layouts are drawn as tiles."
    },
    "chartDesign.styles.changeColors": {
      "args": {
        "palette": "<palette>"
      },
      "note": "U:grid/chart-design: checked against gridcraft (chart.changeColors: colorful, monochrome, accent1 to accent6); the palettes are drawn as tiles."
    },
    "chartDesign.styles.gallery": {
      "args": {
        "style": "<n>"
      },
      "note": "U:grid/chart-design: gridcraft stores a style number 1 to 16 and draws no difference; here each style is a palette with its gridlines and data labels, drawn as a tile.",
      "command": "chart.styleGallery"
    },
    "chartDesign.data.selectData": {
      "note": "U:grid/chart-design: checked against gridcraft (chart.selectData: range, categories, removeSeries)."
    },
    "chartDesign.location.moveChart": {
      "note": "U:grid/chart-design: checked against gridcraft (chart.move: another sheet and a top-left cell)."
    },
    "chartDesign.format.formatPane": {
      "kind": "toggle",
      "note": "U:grid/chart-design: checked against gridcraft (the Format Chart Area pane, panes/formatChart.tsx)."
    },
    "chartDesign.type.changeChartType": {
      "note": "U:grid/chart-design: checked against gridcraft (the Change Chart Type menu runs chart.set; Change Chart Type opens the All Charts list)."
    },
    "chartFormat.selection.formatSelection": {
      "kind": "toggle",
      "note": "U:grid/chart-design: checked against gridcraft (chart.formatSelection: the Format Chart Area pane, or a series colour)."
    },
    "chartFormat.shapeStyles.fill": {
      "note": "U:grid/chart-design: checked against gridcraft (chart.shapeFill: on a chart it fills a series, `series` default the first).",
      "args": {
        "color": "#RRGGBB"
      }
    },
    "shapeFormat.styles.fill": {
      "note": "U:grid/chart-design: checked against gridcraft (chart.shapeFill with kind shape).",
      "args": {
        "color": "#RRGGBB"
      }
    },
    "shapeFormat.styles.outline": {
      "note": "U:grid/chart-design: checked against gridcraft (chart.shapeOutline).",
      "args": {
        "color": "#RRGGBB"
      }
    },
    "shapeFormat.arrange.rotate": {
      "kind": "dropdown",
      "command": null,
      "note": "U:grid/insert-layout: Rotate Right and Left 90 and Flip turn and mirror the picked pictures and shapes (arrange.rotate degrees, flip), as Page Layout > Rotate.",
      "items": [
        {
          "id": "shapeFormat.arrange.rotate.rotate-right-90",
          "label": "Rotate Right 90°",
          "command": "arrange.rotate",
          "params": {
            "degrees": 90
          }
        },
        {
          "id": "shapeFormat.arrange.rotate.rotate-left-90",
          "label": "Rotate Left 90°",
          "command": "arrange.rotate",
          "params": {
            "degrees": -90
          }
        },
        {
          "id": "shapeFormat.arrange.rotate.flip-vertical",
          "label": "Flip Vertical",
          "command": "arrange.rotate",
          "params": {
            "flip": "vertical"
          }
        },
        {
          "id": "shapeFormat.arrange.rotate.flip-horizontal",
          "label": "Flip Horizontal",
          "command": "arrange.rotate",
          "params": {
            "flip": "horizontal"
          }
        }
      ]
    }
  },
  "dialogs": {
    "dialog.selectData": {
      "note": "U:grid/chart-design: checked against gridcraft (dialogs/charts.rs select_data: the data range, the series and the horizontal axis labels).",
