      "kind": "toggle",
      "checkedLabel": "Unprotect Sheet",
      "dialog": "dialog.protectSheet",
      "note": "U:grid/review: checked against gridcraft (review.protectSheet and review.unprotectSheet; the button reads Unprotect Sheet on a protected sheet and asks for the password). Excel's extra permissions (hyperlinks, PivotTables, objects, scenarios) are not in gridcraft and not enforced here, so the dialog leaves them out."
    },
    "review.protect.protectWorkbook": {
      "checkedLabel": "Unprotect Workbook",
      "note": "U:grid/review: checked against gridcraft (review.protectWorkbook: structure only; there are no windows to protect)."
    },
    "review.protect.allowEditRanges": {
      "note": "U:grid/review: checked against gridcraft (review.allowEditRanges: add, modify, delete, unlock with the range password)."
    },
    "review.protect.unshareWorkbook": {
      "command": null,
      "note": "U:grid/review: not in gridcraft (no shared workbooks); hidden."
    }
