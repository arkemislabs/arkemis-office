{
  "controls": {
    "pageLayout.themes.themes": {
      "note": "U:grid/page-layout: checked against gridcraft (cmd::view::themes(): Craft, Slate, Meadow, Ember, Ocean, Orchid, Graphite) and Excel's Office themes; tiles are drawn from the command's own list (pageLayout.theme).",
      "args": {
        "name": "<theme>"
      }
    },
    "pageLayout.themes.colors": {
      "kind": "gallery",
      "note": "U:grid/page-layout: colour sets drawn as tiles from pageLayout.themeColors.",
      "args": {
        "name": "<set>"
      }
    },
    "pageLayout.themes.fonts": {
      "kind": "gallery",
      "note": "U:grid/page-layout: font pairs drawn as tiles from pageLayout.themeFonts.",
      "args": {
        "name": "<pair>"
      }
    },
    "pageLayout.themes.effects": {
      "note": "U:grid/page-layout: checked against gridcraft (pageLayout.themeEffects is registered but does nothing, |_, _| ok()); a file keeps its own effect scheme and the sheet's shapes have no effect scheme to change, so Effects stays hidden."
    },
    "pageLayout.pageSetup.printTitles": {
      "command": null,
      "note": "U:grid/page-layout: opens Page Setup on its Sheet tab, as Excel's Print Titles does (pageLayout.printTitles sets them without the dialog)."
    },
    "pageLayout.pageSetup.background": {
      "command": "pageLayout.background",
      "args": null,
      "dialog": "dialog.sheetBackground",
      "kind": "toggle",
      "checkedLabel": "Delete Background",
      "note": "U:grid/page-layout: checked against gridcraft (background: a picture named \"Sheet background\" placed at A1; clear deletes it). With a background on the sheet the button reads Delete Background and its dialog asks to delete it."
    },
    "pageLayout.scaleToFit.width": {
      "options": [
        "Automatic",
        "1 page",
        "2 pages",
        "3 pages",
        "4 pages",
        "5 pages",
        "6 pages",
        "7 pages",
        "8 pages",
        "9 pages"
      ],
      "args": {
        "width": "<n>"
      }
    },
    "pageLayout.scaleToFit.height": {
      "options": [
        "Automatic",
        "1 page",
        "2 pages",
        "3 pages",
        "4 pages",
        "5 pages",
        "6 pages",
        "7 pages",
        "8 pages",
        "9 pages"
      ],
      "args": {
        "height": "<n>"
      }
    },
    "pageLayout.arrange.selectionPane": {
      "command": "arrange.selectionPane",
      "args": {
        "on": "<bool>"
      },
      "note": "U:grid/page-layout: checked against gridcraft (arrange.selectionPane returns the stacking list; its ribbon has no button). The Selection Pane (src/apps/grid/panes/selection.tsx) lists the objects front to back with names, an eye to hide each, Show All, Hide All and the stacking arrows; not checked against upstream."
    },
    "pageLayout.arrange.align": {
      "command": "arrange.align",
      "note": "U:grid/page-layout: checked against gridcraft (arrange.align takes object ids); with objects picked together (Shift or Ctrl click) Align needs two, Distribute three, as Excel; Snap to Grid and Snap to Shape are window settings the drag follows (not checked against upstream)."
    },
    "pageLayout.arrange.group": {
      "command": "arrange.group",
      "note": "U:grid/page-layout: checked against gridcraft (arrange.group takes object ids and aligns their left edges); picked objects are grouped (`group` on each member, one pick takes the group), Ungroup splits and Regroup puts the last group back (not checked against upstream)."
    },
    "pageLayout.arrange.rotate": {
      "note": "U:grid/page-layout: checked against gridcraft (arrange.rotate swaps the width and height of a shape); Rotate Right and Left 90 and Flip turn and mirror the picked pictures and shapes (rotation, flipH, flipV; charts are not turned), as Excel (not checked against upstream)."
    },
    "pageLayout.scaleToFit.scale": {
      "args": {
        "scale": "<n>"
      }
    },
    "pageLayout.sheetOptions.rightToLeft": {
      "command": "view.rightToLeft",
      "args": {
        "on": "<bool>"
      },
      "note": "U:grid/page-layout: checked against gridcraft (view.rightToLeft, sheet_flag): column A at the right edge, the row headings on the right, the text mirrored with the layout; saved as the sheet view's rightToLeft."
    }
  },
  "commands": {
    "pageLayout.customizeColors": {
      "args": [],
      "sourceRef": "office:Excel Page Layout > Colors > Customize Colors",
      "summary": "Edit the theme colours."
    },
    "pageLayout.customizeFonts": {
      "args": [],
      "sourceRef": "office:Excel Page Layout > Fonts > Customize Fonts",
      "summary": "Edit the theme fonts."
    },
    "pageLayout.headerFooterPreset": {
      "args": [],
      "sourceRef": "office:Excel Header & Footer > Header / Footer presets",
      "summary": "Pick a built-in header or footer text."
    }
  },
  "dialogs": {
    "dialog.pageSetup": {
      "note": "U:grid/page-layout: Excel's Page Setup, four tabs. Print quality, the margin preview, Print… and Options… are left out (the print system dialog owns them); the margin boxes are headerMargin and footerMargin so they differ from the Header/Footer tab's header and footer text.",
      "buttons": [
        "OK",
        "Cancel"
      ],
      "tabs": [
        {
          "name": "Page",
          "fields": [
            {
              "id": "orientation",
              "label": "Orientation",
              "kind": "radio",
              "options": [
                {
                  "value": "portrait",
                  "label": "Portrait"
                },
                {
                  "value": "landscape",
                  "label": "Landscape"
                }
              ]
            },
            {
              "id": "scaling",
              "label": "Scaling",
              "kind": "radio",
              "options": [
                {
                  "value": "adjust",
                  "label": "Adjust to: % normal size"
                },
                {
                  "value": "fit",
                  "label": "Fit to: pages wide by tall"
                }
              ]
            },
            {
              "id": "scale",
              "label": "Adjust to (% normal size)",
              "kind": "number",
              "options": [],
              "visibleWhen": "scaling==adjust"
            },
            {
              "id": "fitWidth",
              "label": "Fit to (pages wide)",
              "kind": "number",
              "options": [],
              "visibleWhen": "scaling==fit"
            },
            {
              "id": "fitHeight",
              "label": "Fit to (pages tall)",
              "kind": "number",
              "options": [],
              "visibleWhen": "scaling==fit"
            },
            {
              "id": "paper",
              "label": "Paper size:",
              "kind": "select",
              "options": [
                "Letter",
                "Legal",
                "Tabloid",
                "Ledger",
                "Executive",
