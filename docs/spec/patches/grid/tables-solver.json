    }
  },
  "commands": {
    "data.solverKeep": {
      "args": [],
      "sourceRef": "office:Excel Data > Analysis > Solver > Solver Results > OK",
      "summary": "Solver Results' OK: keep the Solver solution or restore the original values, write the Answer and Limits reports, return to Solver Parameters (not in gridcraft; its dialog writes the solution when Solve runs and undoes it on Restore)."
    }
  },
