 "dialogs": {
  "dialog.link": {
   "officeButtons": null,
   "note": "U:quill/insert: wordcraft dispatch.rs link_dialog. Browse for File (the system Open dialog, path only), Bookmark… (Select Place in Document: top, headings, bookmarks) and ScreenTip… (saved as w:tooltip) are Word's own, drawn by src/apps/quill/dialogs/link.tsx; E-mail Address makes a mailto: link (not checked against upstream). Create New Document has no engine (no second document is made from a link) and stays hidden.",
   "tabs": [
    {
     "name": "Insert Hyperlink",
     "fields": [
      {
       "id": "linkTo",
       "label": "Link to:",
       "kind": "list",
       "options": [
        {
         "value": "file",
         "label": "Existing File or Web Page"
        },
        {
         "value": "place",
         "label": "Place in This Document"
        },
        {
         "value": "email",
         "label": "E-mail Address"
        }
       ]
      },
      {
       "id": "text",
       "label": "Text to display:",
       "kind": "text"
      },
      {
       "id": "address",
       "label": "Address:",
       "kind": "text",
       "visibleWhen": "linkTo==file"
      },
      {
       "id": "email",
       "label": "E-mail address:",
       "kind": "text",
       "visibleWhen": "linkTo==email"
      },
      {
       "id": "subject",
       "label": "Subject:",
       "kind": "text",
       "visibleWhen": "linkTo==email"
      },
      {
       "id": "place",
       "label": "Select a place in this document:",
       "kind": "list",
       "visibleWhen": "linkTo==place"
      },
      {
       "id": "removeLink",
       "label": "Remove Link",
       "kind": "button",
       "command": "insert.removeLink",
       "visibleWhen": "isLink"
      }
     ]
    }
   ],
   "buttons": [
    "OK",
    "Cancel"
   ]
  },
