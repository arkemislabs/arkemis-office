      "args": [
        "position",
        "index",
        "text",
        "below",
        "after",
        "before"
      ],
      "paramsDoc": "{\"position\"?: after|before|above|below|assistant, \"index\"?: item index (default: the item the Text Pane is on, else the last), \"text\"?: string}"
    },
    "smartArt.removeItem": {
      "id": "smartArt.removeItem",
      "label": "Remove Item",
      "location": "SmartArt Design › Create Graphic",
      "args": [
        "index"
      ],
      "paramsDoc": "{\"index\"?: item index}",
      "summary": "Remove Item (SmartArt Design): the item goes and its sub-items move up a level"
    },
    "smartArt.moveUp": {
      "id": "smartArt.moveUp",
      "label": "Move Up",
      "location": "SmartArt Design › Create Graphic",
      "args": [
        "index"
      ],
      "paramsDoc": "{\"index\"?: item index}",
      "summary": "Move Up (SmartArt Design › Create Graphic)"
    },
    "smartArt.moveDown": {
      "id": "smartArt.moveDown",
      "label": "Move Down",
      "location": "SmartArt Design › Create Graphic",
      "args": [
        "index"
      ],
      "paramsDoc": "{\"index\"?: item index}",
      "summary": "Move Down (SmartArt Design › Create Graphic)"
    },
    "smartArt.rtl": {
      "id": "smartArt.rtl",
      "label": "Right to Left",
      "location": "SmartArt Design › Create Graphic",
      "args": [
        "value"
      ],
      "paramsDoc": "{\"value\"?: bool}",
      "summary": "Right to Left (SmartArt Design › Create Graphic)"
    },
    "smartArt.layout": {
      "args": [
        "layout"
      ],
      "paramsDoc": "{\"layout\": one of the 45 layout ids (list, blockList, hBulletList, process, chevron, ..., nestedTarget)}"
    },
    "smartArt.colors": {
      "args": [
        "colors",
        "variant"
      ],
      "paramsDoc": "{\"colors\": colorful|range23|range34|range45|range56|accent1..accent6|accent1Grad..accent6Grad}"
    },
    "smartArt.style": {
      "id": "smartArt.style",
      "label": "SmartArt Styles",
      "location": "SmartArt Design › SmartArt Styles",
      "args": [
        "style"
      ],
      "paramsDoc": "{\"style\": flat|subtle|intense|outline|polished|inset|cartoon|powder|brick}",
      "summary": "SmartArt Styles (SmartArt Design)"
    },
    "smartArt.size": {
      "id": "smartArt.size",
      "label": "SmartArt Size",
      "location": "SmartArt Design › Size",
      "args": [
        "width",
        "height"
      ],
      "paramsDoc": "{\"width\"?: pt, \"height\"?: pt}",
      "summary": "Size (SmartArt Design)"
    },
    "insert.smartArt": {
      "args": [
        "layout",
        "items",
        "colors",
        "style",
        "width",
        "height"
      ],
      "paramsDoc": "{\"layout\"?: one of the 45 layout ids, \"items\"?: [string | {text, level}], \"colors\"?, \"style\"?, \"width\"?: pt, \"height\"?: pt}"
    }
  },
