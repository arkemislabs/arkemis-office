{
  "controls": {
    "smartart-design.create-graphic.add-shape": {
      "args": null,
      "command": "smartArt.addShape",
      "note": "U:quill/smartart: smartArt.addShape (wordcraft cmd/smart_art.rs `add_shape`, with PowerPoint's outline operations, core/prism/lib/smartart.mjs): a new item after, before, above or below the item the Text Pane is on (the last without one), or an assistant of an organization chart.",
      "items": [
        {
          "id": "smartart-design.create-graphic.add-shape.add-shape-after",
          "label": "Add Shape After",
          "kind": "button",
          "command": "smartArt.addShape",
          "args": {
            "position": "after"
          },
          "source": "office"
        },
        {
          "id": "smartart-design.create-graphic.add-shape.add-shape-before",
          "label": "Add Shape Before",
          "kind": "button",
          "command": "smartArt.addShape",
          "args": {
            "position": "before"
          },
          "source": "office"
        },
        {
          "id": "smartart-design.create-graphic.add-shape.add-shape-above",
          "label": "Add Shape Above",
          "kind": "button",
          "command": "smartArt.addShape",
          "args": {
            "position": "above"
          },
          "source": "office"
        },
        {
          "id": "smartart-design.create-graphic.add-shape.add-shape-below",
          "label": "Add Shape Below",
          "kind": "button",
          "command": "smartArt.addShape",
          "args": {
            "position": "below"
          },
          "source": "office"
        },
        {
          "id": "smartart-design.create-graphic.add-shape.add-assistant",
          "label": "Add Assistant",
          "kind": "button",
          "command": "smartArt.addShape",
          "args": {
            "position": "assistant"
          },
          "source": "office"
        }
      ]
    },
    "smartart-design.create-graphic.add-bullet": {
      "command": "smartArt.addShape",
      "args": {
        "position": "below"
      },
      "note": "U:quill/smartart: a new sub-item under the item the Text Pane is on (the outline's next level); the same operation as Add Shape Below. Not checked against upstream."
    },
    "smartart-design.create-graphic.promote": {
      "args": null,
      "note": "U:quill/smartart: smartArt.promote (wordcraft cmd/smart_art.rs): the item the Text Pane is on and the items under it move up a level."
    },
    "smartart-design.create-graphic.demote": {
      "args": null,
      "note": "U:quill/smartart: smartArt.demote (wordcraft cmd/smart_art.rs): the item and the items under it move down a level, under the item before it."
    },
    "smartart-design.create-graphic.text-pane": {
      "note": "U:quill/smartart: smartArt.textPane (wordcraft cmd/smart_art.rs) shows the Text Pane (panes/smartArtText.tsx): the items as bullet rows; Enter adds an item after, Tab and Shift+Tab demote and promote, Backspace on an empty row removes it."
    },
    "smartart-design.create-graphic.right-to-left": {
      "command": "smartArt.rtl",
      "note": "U:quill/smartart: mirrors the graphic (smartArt.rtl). Word's, not in wordcraft: not checked against upstream."
    },
    "smartart-design.create-graphic.move-up": {
      "command": "smartArt.moveUp",
      "note": "U:quill/smartart: the item and its sub-items go above the item before it on its level (smartArt.moveUp). Word's, not in wordcraft: not checked against upstream."
    },
    "smartart-design.create-graphic.move-down": {
      "command": "smartArt.moveDown",
      "note": "U:quill/smartart: the item and its sub-items go below the item after it on its level (smartArt.moveDown). Word's, not in wordcraft: not checked against upstream."
    },
    "smartart-design.create-graphic.layout": {
      "note": "U:quill/smartart: hidden: Word's Layout menu offers the organization chart layouts (Standard, Both, Left Hanging, Right Hanging) and neither wordcraft nor PowerPoint's engine has them; the Layouts gallery changes the layout."
    },
    "smartart-design.layouts.layouts": {
      "args": {
        "layout": "<layout>"
      },
      "note": "U:quill/smartart: smartArt.layout: all 45 of PowerPoint's SmartArt layouts (core/prism/lib/smartart.mjs), each drawn small from the sample outline in the graphic's own colours and style; wordcraft has eight (basicList, process, cycle, hierarchy, pyramid, radial, matrix, venn)."
    },
    "smartart-design.smartart-styles.change-colors": {
      "kind": "gallery",
      "args": {
        "colors": "<id>"
      },
      "items": null,
      "note": "U:quill/smartart: smartArt.colors: Colorful, the four Colorful Ranges, one accent for every shape (Accent 1 to 6) and the six Gradient Ranges, each drawn as swatches of the document's theme (wordcraft has accent1 to accent6 and colorful)."
    },
    "smartart-design.smartart-styles.smartart-styles": {
      "command": "smartArt.style",
      "args": {
        "style": "<style>"
      },
      "note": "U:quill/smartart: smartArt.style: the nine SmartArt Styles, drawn on the graphic itself: Simple Fill, Subtle Effect, Intense Effect, White Outline and the bevelled Polished, Inset, Cartoon, Powder and Brick Scene (shown flat, with the shadow; the 3-D scene is not drawn)."
    },
    "smartart-design.reset.reset-graphic": {
      "note": "U:quill/smartart: smartArt.reset (wordcraft cmd/smart_art.rs): back to the default colours and style (and not mirrored); the items and layout stay."
    },
    "smartart-design.reset.convert": {
      "note": "U:quill/smartart: hidden: Convert to Text and Convert to Shapes have no engine in wordcraft (a Word page keeps a group's shapes as one drawing: groups do not hold shapes here)."
    },
    "smartart-design.size.h": {
      "command": "smartArt.size",
      "args": {
        "height": "<pt>",
        "lockAspect": null
      },
      "note": "U:quill/smartart: smartArt.size: the graphic's height in points; the shapes are laid out again at the new size."
    },
    "smartart-design.size.w": {
      "command": "smartArt.size",
      "args": {
        "width": "<pt>",
        "lockAspect": null
      },
      "note": "U:quill/smartart: smartArt.size: the graphic's width in points; the shapes are laid out again at the new size."
    }
  },
  "commands": {
    "smartArt.outline": {
      "id": "smartArt.outline",
