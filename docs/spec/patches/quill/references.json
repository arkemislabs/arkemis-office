 "dialogs": {
  "dialog.toc": {
   "title": "Table of Contents",
   "command": "references.toc",
   "note": "U:quill/references: wordcraft dialogs_refs/toc.rs toc_ui and toc_options_ui (Options… is the Build table of contents from section); drawn by src/apps/quill/dialogs/toc.tsx.",
   "tabs": [
    {
     "name": "Table of Contents",
     "fields": [
      {
       "id": "printPreview",
       "label": "Print Preview",
       "kind": "preview"
      },
      {
       "id": "pageNumbers",
       "label": "Show page numbers",
       "kind": "checkbox"
      },
      {
       "id": "rightAlign",
       "label": "Right align page numbers",
       "kind": "checkbox"
      },
      {
       "id": "tabLeader",
       "label": "Tab leader:",
       "kind": "select",
       "options": [
        {
         "value": "none",
         "label": "(none)"
        },
        {
         "value": "dot",
         "label": "........"
        },
        {
         "value": "hyphen",
         "label": "--------"
        },
        {
         "value": "underscore",
         "label": "________"
        }
       ]
      },
      {
       "id": "hyperlinks",
       "label": "Use hyperlinks instead of page numbers in Web view",
       "kind": "checkbox"
      },
      {
       "id": "levels",
       "label": "Show levels:",
       "kind": "number",
       "min": 1,
       "max": 9
      },
      {
       "id": "headingStyles",
       "label": "Styles",
       "kind": "checkbox"
      },
      {
       "id": "outlineLevels",
       "label": "Outline levels",
       "kind": "checkbox"
      },
      {
       "id": "tcFields",
       "label": "Table entry fields",
       "kind": "checkbox"
      }
     ]
    }
   ],
   "buttons": [
    "OK",
    "Cancel"
   ]
  },
  "dialog.updateToc": {
   "title": "Update Table of Contents",
   "command": "references.updateToc",
   "note": "U:quill/references: Word's Update Table of Contents dialog (office).",
   "tabs": [
    {
     "name": "Update",
     "fields": [
      {
       "id": "mode",
       "label": "Quill is updating the table of contents. Select one of the following options:",
       "kind": "radio",
       "options": [
        {
         "value": "pages",
         "label": "Update page numbers only"
        },
        {
         "value": "entire",
         "label": "Update entire table"
        }
       ]
      }
     ]
    }
   ],
   "buttons": [
    "OK",
    "Cancel"
   ],
   "source": "office"
  },
