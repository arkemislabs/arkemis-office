 "dialogs": {
  "dialog.newBuildingBlock": {
   "title": "Create New Building Block",
   "command": "insert.quickParts",
   "note": "U:quill/insert: Word's Create New Building Block over insert.quickParts / insert.autoText `save` (the name, gallery, category, description and where it is kept). Word's Options (insert content only, in its own paragraph or page) are not kept.",
   "tabs": [
    {
     "name": "Create New Building Block",
     "fields": [
      {
       "id": "name",
       "label": "Name:",
       "kind": "text"
      },
      {
       "id": "gallery",
       "label": "Gallery:",
       "kind": "select",
       "options": [
        "Quick Parts",
        "AutoText"
       ]
      },
      {
       "id": "category",
       "label": "Category:",
       "kind": "text"
      },
      {
       "id": "description",
       "label": "Description:",
       "kind": "textarea"
      },
      {
       "id": "location",
       "label": "Save in:",
       "kind": "select",
       "options": [
        "Settings (all documents)",
        "This document"
       ]
      }
     ]
    }
   ],
   "buttons": [
    "OK",
    "Cancel"
   ]
  },
  "dialog.buildingBlocks": {
   "title": "Building Blocks Organizer",
   "command": "insert.quickParts",
   "note": "U:quill/insert: Word's Building Blocks Organizer over insert.quickParts (insert, delete) and insert.buildingBlockProperties (Edit Properties…); a table that sorts by Name, Gallery, Category or Template, with a preview and the description; drawn by src/apps/quill/dialogs/buildingBlocks.tsx.",
   "tabs": [
    {
     "name": "Building Blocks",
     "fields": [
      {
       "id": "name",
       "label": "Building block:",
