    "dialog.pasteSpecial": {
      "note": "As upstream crates/ui-egui/src/dialogs/dispatch.rs paste_special_dialog (U:quill/paste): Paste as (the formats the clipboard holds) and the Result line. Word's Source, Paste link and Display as icon are OLE-object options neither upstream nor Quill has.",
      "tabs": [
        {
          "name": "Paste Special",
          "fields": [
            {
              "id": "as",
              "label": "Paste as:",
              "kind": "radio",
              "options": [
                {
                  "value": "formatted",
                  "label": "Formatted Text"
                },
                {
                  "value": "rtf",
                  "label": "Rich Text Format (RTF)"
                },
                {
                  "value": "html",
                  "label": "HTML Format"
                },
                {
                  "value": "picture",
                  "label": "Picture"
                },
                {
                  "value": "text",
                  "label": "Unformatted Text"
                }
              ]
            },
            {
              "id": "result",
              "label": "Result",
              "kind": "preview"
            }
          ]
        }
      ],
      "buttons": [
        "OK",
        "Cancel"
      ]
