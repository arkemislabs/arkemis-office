{
  "controls": {
    "home.editing.replace": {
      "command": null,
      "note": "Upstream's ui.dialog {name: replace} is a front-end request: the control opens Find and Replace on its Replace tab (U:quill/edit)."
    },
    "home.editing.find.go-to": {
      "command": null,
      "note": "Upstream's ui.dialog {name: goto}: the control opens Find and Replace on its Go To tab (U:quill/edit)."
    }
  },
