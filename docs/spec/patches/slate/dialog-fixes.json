            },
            {
              "id": "name",
              "label": "Notebook Name",
              "kind": "text",
              "options": []
            },
            {
              "id": "folder",
              "label": "Folder",
              "kind": "text",
              "options": [],
              "input": "folder-picker",
              "visibleWhen": "location!=Browse..."
            }
          ]
        }
      ]
