    "dialog.page-templates": {
      "note": "Dialog fix: the lists draw the categories and templates the model keeps; Add Page and Set as Default run its handlers. Only My Templates exists (the templates the person saved): OneNote's installed categories (Academic, Blank, Business, Decorative, Planners) have no template pages here, so they are not listed, and Templates online is hidden (no web).",
      "tabs": [
        {
          "name": "Add a page",
          "fields": [
            {
              "id": "category",
              "label": "Category",
              "kind": "list",
              "options": [],
              "itemsFrom": "categories",
              "height": 72
            },
            {
              "id": "template",
              "label": "Template",
              "kind": "list",
              "options": [],
              "itemsFrom": "templateItems",
              "empty": "No templates yet: save a page as a template.",
              "height": 150
            },
            {
              "id": "addPage",
              "label": "Add Page",
              "kind": "button",
              "options": []
