  "dialog.hyperlink": {
   "note": "U:prism/insert: deckcraft hyperlink.rs (Web Page, This Document, Email Address; ScreenTip). Place in This Document lists First, Last, Next and Previous Slide and every slide by title; Browse next to the address picks a file (the file's name is the address). Hidden: Create New Document, Subject, Bookmark and Target Frame (a click opens a web page or mail in the default app, or goes to a slide; there is no frame to target).",
   "tabs": [
    {
     "name": "Link to",
     "fields": [
      {
       "id": "mode",
       "label": "Link to:",
       "kind": "radio",
       "options": [
        {
         "value": "url",
         "label": "Existing Web Page"
        },
        {
         "value": "slide",
         "label": "Place in This Document"
        },
        {
         "value": "email",
         "label": "Email Address"
        }
       ],
       "source": "upstream",
       "sourceRef": "deckcraft crates/ui-egui/src/dialogs/hyperlink.rs"
      },
      {
       "id": "display",
       "label": "Text to display:",
       "kind": "text",
       "visibleWhen": "!hasText",
       "param": "text",
       "source": "upstream",
       "sourceRef": "deckcraft crates/ui-egui/src/dialogs/hyperlink.rs"
      },
      {
       "id": "url",
       "label": "Address:",
       "kind": "text",
       "visibleWhen": "mode==url",
       "param": "url",
       "source": "upstream",
       "sourceRef": "deckcraft crates/ui-egui/src/dialogs/hyperlink.rs"
      },
      {
       "id": "slide",
       "label": "Place in this document:",
       "kind": "select",
       "visibleWhen": "mode==slide",
       "param": "slide | jump",
       "source": "upstream",
       "sourceRef": "deckcraft crates/ui-egui/src/dialogs/hyperlink.rs",
       "itemsFrom": "slideTargets",
       "options": []
      },
      {
       "id": "email",
       "label": "Email address:",
       "kind": "text",
       "visibleWhen": "mode==email",
       "param": "url (mailto:)",
       "source": "upstream",
       "sourceRef": "deckcraft crates/ui-egui/src/dialogs/hyperlink.rs"
      },
      {
       "id": "tip",
       "label": "ScreenTip:",
       "kind": "text",
       "param": "tooltip",
       "source": "upstream",
       "sourceRef": "deckcraft crates/ui-egui/src/dialogs/hyperlink.rs"
      }
     ]
    }
   ]
  },
