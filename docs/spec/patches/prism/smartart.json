{
  "controls": {
    "insert.illustrations.smartart": {
      "command": "insert.smartArt",
      "dialog": "dialog.smartart",
      "params": null,
      "note": "U:prism/smartart: opens Choose a SmartArt Graphic (all 45 of deckcraft's layouts drawn as thumbnails, by category); the graphic is a group of real shapes with its outline, edited in the Text Pane, and fills the slide's empty content placeholder or the space below the title. Saved to .pptx as PowerPoint's diagram parts (data, layout, quick style, colours and the drawing of its shapes), so PowerPoint opens it as SmartArt; opened again it is the graphic with its outline. Text typed into a diagram shape is read back into the outline."
    },
    "home.paragraph.smartart": {
      "command": "smartArt.fromText",
      "params": {
        "kind": "<layout>"
      },
      "note": "U:prism/smartart: Convert to SmartArt: the selected text box becomes a graphic of the chosen layout, one node per paragraph with its indent level."
    },
    "pictureformat.styles.layout": {
      "command": "smartArt.fromText",
      "params": {
        "kind": "<layout>"
      },
      "note": "U:prism/smartart: Picture Layout: the selected text box becomes a graphic of the chosen layout (the picture layouts hold the pictures of the nodes)."
    },
    "smartart.create.insert-picture": {
      "command": "smartArt.picture",
      "params": null,
      "note": "U:prism/smartart: adds a picture to the picture placeholder of the graphic's last node (the system Open dialog picks the file); Text Pane commands pick the node by index."
    },
    "smartart.create.text-pane": {
      "command": "pane.toggle",
      "params": {
        "pane": "smartart",
        "toggle": null
      },
      "kind": "toggle",
      "note": "U:prism/smartart: shows or hides the Text Pane (panes/smartart.tsx): the outline as bullet rows; Enter adds after, Tab and Shift+Tab demote and promote, Backspace on an empty row removes it."
    },
    "smartart.create.rtl": {
      "command": "smartArt.rtl",
      "params": null,
      "note": "U:prism/smartart: Right to Left: the graphic is mirrored across its middle; saved in the diagram as its direction (not in deckcraft, not checked against upstream: done as PowerPoint reverses a graphic)."
    },
    "smartart.create.move-up": {
      "command": "smartArt.moveUp",
      "params": null,
      "note": "U:prism/smartart: Move Up: the node (the last one, or index) and its sub-points swap places with the sibling above, at the same level (not in deckcraft, not checked against upstream)."
    },
    "smartart.create.move-down": {
      "command": "smartArt.moveDown",
      "params": null,
      "note": "U:prism/smartart: Move Down: the node and its sub-points swap places with the sibling below (not in deckcraft, not checked against upstream)."
    },
    "smartart.create.layout": {
      "command": null,
      "params": null,
      "options": [
        "Standard",
        "Both",
        "Left Hanging",
        "Right Hanging"
      ],
      "items": [
        {
          "label": "Standard",
          "command": "smartArt.branch",
          "params": {
            "branch": "standard"
          },
          "source": "office",
          "sourceRef": "office: Microsoft PowerPoint"
        },
        {
          "label": "Both",
          "command": "smartArt.branch",
          "params": {
            "branch": "both"
          },
          "source": "office",
          "sourceRef": "office: Microsoft PowerPoint"
        },
        {
          "label": "Left Hanging",
          "command": "smartArt.branch",
          "params": {
            "branch": "left"
          },
          "source": "office",
          "sourceRef": "office: Microsoft PowerPoint"
        },
        {
          "label": "Right Hanging",
          "command": "smartArt.branch",
          "params": {
            "branch": "right"
          },
          "source": "office",
          "sourceRef": "office: Microsoft PowerPoint"
        }
      ],
      "note": "U:prism/smartart: Layout (organization charts only): Standard, Both, Left Hanging, Right Hanging; saved as the branch layout of the diagram (not in deckcraft, not checked against upstream). Disabled for other layouts."
    },
    "smartart.styles.gallery": {
      "command": "smartArt.style",
      "params": {
        "style": "<style>"
      },
      "note": "U:prism/smartart: the nine SmartArt Styles, drawn on the graphic itself: Simple Fill, Subtle Effect, Intense Effect, White Outline, and the bevelled Polished, Inset, Cartoon, Powder and Brick Scene (its bevel is kept; its 3-D camera is not drawn)."
    },
    "smartart.reset.reset": {
      "command": "smartArt.reset",
      "params": null,
      "note": "U:prism/smartart: Reset Graphic: colours, style, direction and branch layout go back to the defaults and the shapes are drawn again from the outline; text, levels and pictures stay (not in deckcraft, not checked against upstream)."
    },
    "smartart.layouts.gallery": {
      "note": "U:prism/smartart: all 45 layouts, each drawn from the sample outline in the graphic's own colours and style."
    },
    "smartart.styles.colors": {
      "note": "U:prism/smartart: Colorful, the four Colorful Ranges, one accent for every shape, and the six Gradient Ranges, each drawn as swatches of the theme."
    }
  },
