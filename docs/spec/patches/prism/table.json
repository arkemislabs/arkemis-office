  "tabledesign.wordart.quick": {
   "note": "U:prism/table: hidden: deckcraft only inserts new WordArt (insert.wordArt); it has no engine that applies a WordArt look to existing table text. Text Fill, Text Outline and Text Effects format the text of the selected cells (or every cell)."
  },
