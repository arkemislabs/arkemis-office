  "tabledesign.styles.gallery": {
   "note": "U:prism/table: deckcraft ribbon/table.rs table_design: the inline strip is none, grid and Medium Style 2 (up to 8), the drop-down holds every built-in style (Light, Medium, Dark each for Text 1 and Accent 1-6) and the styles the file defines, each drawn with the table's own style options and the theme colours. Clear Table is No Style, No Grid."
  },
  "tabledesign.styles.shading": {
   "note": "U:prism/table: deckcraft cell_fill (a colour or none). Table Background is PowerPoint's fill behind the whole table (deckcraft keeps it in the model and draws it). Gradient (light and dark variations of the cell's colour, in four directions) is PowerPoint's own and not checked against upstream. Picture needs a picture chooser (table.cellFill takes `picture` as base64 over the bridge) and Texture has no gallery, so both stay hidden.",
   "items": [
    {
     "label": "Theme Colors / Standard Colors",
     "command": "table.cellFill",
     "params": {
      "color": "<colorRef>"
     },
     "kind": "color",
     "source": "upstream",
     "sourceRef": "crates/ui-egui/src/widgets.rs:378"
    },
    {
     "label": "No Fill",
     "command": "table.cellFill",
     "params": {
      "none": true
     },
     "source": "upstream"
    },
    {
     "label": "Gradient",
     "kind": "submenu",
     "source": "office",
     "sourceRef": "office: Microsoft PowerPoint",
     "items": [
      {
       "header": "Light Variations"
      },
      {
       "label": "Light Linear Down",
       "command": "table.cellFill",
       "params": {
        "variation": "light",
        "angle": 90
       },
       "source": "office"
      },
      {
       "label": "Light Linear Up",
       "command": "table.cellFill",
       "params": {
        "variation": "light",
        "angle": 270
       },
       "source": "office"
      },
      {
       "label": "Light Linear Left",
       "command": "table.cellFill",
       "params": {
        "variation": "light",
        "angle": 180
       },
       "source": "office"
      },
      {
       "label": "Light Linear Right",
       "command": "table.cellFill",
       "params": {
        "variation": "light",
        "angle": 0
       },
       "source": "office"
      },
      {
       "header": "Dark Variations"
      },
      {
       "label": "Dark Linear Down",
       "command": "table.cellFill",
       "params": {
        "variation": "dark",
        "angle": 90
       },
       "source": "office"
      },
      {
       "label": "Dark Linear Up",
       "command": "table.cellFill",
       "params": {
        "variation": "dark",
        "angle": 270
       },
       "source": "office"
      },
      {
       "label": "Dark Linear Left",
       "command": "table.cellFill",
       "params": {
        "variation": "dark",
        "angle": 180
       },
       "source": "office"
      },
      {
       "label": "Dark Linear Right",
       "command": "table.cellFill",
       "params": {
        "variation": "dark",
        "angle": 0
       },
       "source": "office"
      }
     ]
    },
    {
     "label": "Table Background",
     "kind": "submenu",
     "source": "office",
     "sourceRef": "office: Microsoft PowerPoint",
     "items": [
      {
       "label": "No Fill",
       "command": "table.background",
       "params": {
        "none": true
       },
       "source": "office"
      },
      {
       "label": "Theme Colors / Standard Colors",
       "command": "table.background",
       "params": {
        "color": "<colorRef>"
       },
       "kind": "color",
       "source": "office"
      }
     ]
    }
   ]
  },
