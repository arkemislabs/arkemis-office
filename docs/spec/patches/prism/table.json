 "dialogs": {
  "dialog.cellMargins": {
   "note": "U:prism/table: PowerPoint's Cell Text Layout: vertical alignment, text direction and the four internal margins of the selected cells, in inches. deckcraft has the four margin presets only (not checked against upstream).",
   "tabs": [
    {
     "name": "Layout",
     "fields": [
      {
       "id": "anchor",
       "label": "Vertical alignment:",
       "kind": "select",
       "options": [
        {
         "value": "top",
         "label": "Top"
        },
        {
         "value": "middle",
         "label": "Middle"
        },
        {
         "value": "bottom",
         "label": "Bottom"
        }
       ],
       "source": "office"
      },
      {
       "id": "direction",
       "label": "Text direction:",
       "kind": "select",
       "options": [
        {
         "value": "horizontal",
         "label": "Horizontal"
        },
        {
         "value": "rotate90",
         "label": "Rotate all text 90°"
        },
        {
         "value": "rotate270",
         "label": "Rotate all text 270°"
        },
        {
         "value": "stacked",
         "label": "Stacked"
        }
       ],
       "source": "office"
      },
      {
       "id": "left",
       "label": "Left:",
       "kind": "number",
       "min": 0,
       "max": 5.5,
       "step": 0.05,
       "unit": "in",
       "source": "office"
      },
      {
       "id": "right",
       "label": "Right:",
       "kind": "number",
       "min": 0,
       "max": 5.5,
       "step": 0.05,
       "unit": "in",
       "source": "office"
      },
      {
       "id": "top",
       "label": "Top:",
       "kind": "number",
       "min": 0,
       "max": 5.5,
       "step": 0.05,
       "unit": "in",
       "source": "office"
      },
      {
       "id": "bottom",
       "label": "Bottom:",
       "kind": "number",
       "min": 0,
       "max": 5.5,
       "step": 0.05,
       "unit": "in",
       "source": "office"
      }
     ]
    }
   ]
  },
  "dialog.splitCells": {
   "note": "U:prism/table: PowerPoint's Split Cells; deckcraft's table.split only undoes a merge (not checked against upstream). A merged cell starts with the columns and rows it spans.",
   "tabs": [
    {
     "name": "Split",
     "fields": [
      {
       "id": "cols",
       "label": "Number of columns:",
       "kind": "number",
       "min": 1,
       "max": 63,
       "step": 1,
       "default": 2,
       "source": "office"
      },
      {
       "id": "rows",
       "label": "Number of rows:",
       "kind": "number",
       "min": 1,
       "max": 63,
       "step": 1,
       "default": 1,
       "source": "office"
      }
     ]
    }
   ]
  }
