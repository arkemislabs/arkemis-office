{
  "tab": "equation",
  "source": "wordcraft aadb077e072b7de05f724e359d8db82e151f125c crates/ui-egui/src/equation_tab.rs (show: Tools = Equation large + Unicode/LaTeX/Convert column + Normal Text column, Symbols row gallery, Structures = eleven large gallery buttons, Equation Options = Display/Inline/Number column + Justification/Close Equation column); Ink Equation placed as in Word for Windows",
  "groups": {
    "tools": {
      "collapseOrder": 4,
      "launcher": {"dialog": "dialog.equationOptions"},
      "layout": [
        {"large": "equation.tools.equation"},
        {"large": "equation.tools.ink-equation"},
        {"stack": ["equation.tools.unicode", "equation.tools.latex", "equation.tools.convert"]},
        {"stack": ["equation.tools.normal-text"]}
      ]
    },
    "symbols": {
      "collapseOrder": 1,
      "layout": [
        {"gallery": "equation.symbols.symbols", "inline": true, "columns": 8}
      ]
    },
    "structures": {
      "collapseOrder": 2,
      "layout": [
        {"large": "equation.structures.fraction"},
        {"large": "equation.structures.script"},
        {"large": "equation.structures.radical"},
        {"large": "equation.structures.integral"},
        {"large": "equation.structures.large-operator"},
        {"large": "equation.structures.bracket"},
        {"large": "equation.structures.function"},
        {"large": "equation.structures.accent"},
        {"large": "equation.structures.limit-and-log"},
        {"large": "equation.structures.operator"},
        {"large": "equation.structures.matrix"}
      ]
    },
    "equation-options": {
      "collapseOrder": 3,
      "layout": [
        {"stack": ["equation.equation-options.display", "equation.equation-options.inline", "equation.equation-options.number"]},
        {"stack": ["equation.equation-options.justification", "equation.equation-options.close-equation"]}
      ]
    }
  }
}
